# Application Configuration
PROJECT_NAME="MultiModal Document Intelligence & RAG"
API_V1_STR="/api/v1"
SECRET_KEY="your-production-secret-key-change-this"
JWT_SECRET="your-production-jwt-secret-change-this"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment & Server Config
ENVIRONMENT="development" # 'development' or 'production'
LOG_LEVEL="INFO"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_rag_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doc_rag_db

# External AI & Vector DB Providers Config
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_VISION_MODEL="gemini-3.5-flash-lite"
CHROMA_PERSIST_DIR="./chroma_data"
STORAGE_LOCAL_DIR="./uploaded_files"
MAX_UPLOAD_SIZE_MB=50
